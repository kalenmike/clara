{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clara-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOMS",
        "class_name": "RelayRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"],
    },
  ],
  "routes": [
    {
      "pattern": "relay.clara.kalenmichael.com",
      "custom_domain": true,
    },
  ],
}
