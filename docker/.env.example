# Generate with: openssl rand -hex 32
CLARA_ORCHESTRATION_TOKEN=replace-with-a-long-random-token

# Absolute host path to the repository or workspace that contains
# orchestration/index.yml. Compose mounts it at /workspace/clara, which is the
# workspace the orchestrator reports. Mount it at the same path in the OpenCode
# container.
CLARA_WORKSPACE=/absolute/path/to/clara
