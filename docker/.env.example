# Generate with: openssl rand -hex 32
CLARA_ORCHESTRATION_TOKEN=replace-with-a-long-random-token

# Absolute host path to the repository or workspace that contains
# orchestration/index.yml. Compose mounts it at /workspace/clara, which is the
# workspace the orchestrator reports. Mount it at the same path in the OpenCode
# container.
CLARA_WORKSPACE=/absolute/path/to/clara

# Absolute host directory for the orchestrator database and token. Compose
# mounts it at /data.
CLARA_DATA_DIR=/absolute/path/to/clara-data

# --- Home agent container (docker/server.compose.yml) ---------------------

# Containing server.json, vapid.json, subscriptions.json, secrets.key, and the
# one-time admin-setup.txt. Defaults to ~/.config/clara.
CLARA_SERVER_CONFIG_DIR=/absolute/path/to/clara-config

# Containing clara.db. Defaults to ~/.local/share/clara.
CLARA_SERVER_DATA_DIR=/absolute/path/to/clara-data

# Optional: supply the one-time panel setup token instead of writing
# admin-setup.txt. This is not the superadmin password, and it is consumed once.
# Prefer a Docker secret or a file mounted at CLARA_ADMIN_SETUP_TOKEN_FILE.
# CLARA_ADMIN_SETUP_TOKEN=
# CLARA_ADMIN_SETUP_TOKEN_FILE=/run/secrets/clara-admin-setup

# Optional: key used to encrypt harness credentials at rest. If unset, the
# server generates secrets.key in the config directory with mode 0600.
# CLARA_SECRET_KEY=
# CLARA_SECRET_KEY_FILE=/run/secrets/clara-secret-key

# Optional relay settings for the home agent. A relay URL requires both tokens.
# Keep CLARA_RELAY_ROOM stable across restarts and across `pair` commands:
# pairing codes are scoped to the room. When it is omitted, the agent generates
# one and persists it in server.json.
# CLARA_RELAY_URL=wss://relay.example
# CLARA_RELAY_ROOM=
# CLARA_AGENT_TOKEN=
# CLARA_CLIENT_TOKEN=

# URL where the web app is served. Defaults to the local web container. Set
# your own HTTPS URL for Pages or a remote web deployment.
# CLARA_PAIRING_BASE_URL=http://127.0.0.1:8080

# Optional VAPID overrides. If unset, vapid.json is generated in the config
# directory.
# CLARA_VAPID_PUBLIC_KEY=
# CLARA_VAPID_PRIVATE_KEY=
# CLARA_VAPID_SUBJECT=

# Set to 1 when the panel is served through an HTTPS reverse proxy.
# CLARA_PANEL_SECURE_COOKIE=0

# --- Web client container (docker/web.compose.yml) ------------------------

# Host loopback port for the static app. Defaults to 8080.
# CLARA_WEB_PORT=8080

# Baked into the bundle at image build time. Leave unset to use the relay URL
# carried by each pairing code; local codes keep their own ws:// URL. Set it
# only when the browser must use a different relay endpoint than the agent,
# then rebuild with `--build`. Keep the value here so `pnpm clara rebuild`
# recreates the image with the same endpoint.
# VITE_CLARA_WS_URL=wss://relay.example

