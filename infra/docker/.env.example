# `pnpm clara start` creates this file on first run. Copy it manually when
# starting one compose project on its own.
#
# This file belongs to the Docker stack. Local installs keep using
# ~/.config/clara and ~/.local/share/clara and never read it.
#
# --- Orchestrator container (infra/docker/orchestrator.compose.yml) ---------------

# Generate with: openssl rand -hex 32
CLARA_ORCHESTRATION_TOKEN=replace-with-a-long-random-token

# Absolute host path to the repository or workspace used by the workers.
# Compose mounts it at /workspace/clara, which is the workspace the orchestrator
# reports. Mount it at the same path in the OpenCode container.
CLARA_WORKSPACE=/absolute/path/to/clara

# Optional: path to a custom index.yml inside the mounted workspace. Leave unset
# to use the config bundled with the orchestrator. The value is the container
# path, for example /workspace/clara/my-pipelines/index.yml.
# CLARA_ORCHESTRATION_CONFIG=

# Optional: bind the orchestrator database and container token to a host
# directory instead of the clara-orchestrator-data volume.
# CLARA_ORCHESTRATOR_DATA_DIR=/absolute/path/to/clara-orchestrator-data

# --- Hub container (infra/docker/server.compose.yml) ---------------------

# Optional: bind server config or data to host directories instead of the
# clara-server-config and clara-server-data volumes.
# CLARA_SERVER_CONFIG_DIR=/absolute/path/to/clara-config
# CLARA_SERVER_DATA_DIR=/absolute/path/to/clara-data

# Optional: supply the one-time panel setup token instead of writing
# admin-setup.txt. This is not the superadmin password, and it is consumed once.
# Prefer a Docker secret or a file mounted at CLARA_ADMIN_SETUP_TOKEN_FILE.
# CLARA_ADMIN_SETUP_TOKEN=
# CLARA_ADMIN_SETUP_TOKEN_FILE=/run/secrets/clara-admin-setup

# Optional: key used to encrypt harness credentials at rest. If unset, the
# server generates secrets.key in the config directory with mode 0600.
# CLARA_SECRET_KEY=
# CLARA_SECRET_KEY_FILE=/run/secrets/clara-secret-key

# Build-time: compile the hub panel's one-click Cloudflare relay deployment
# into the panel and hub service. Requires a rebuild. Anything other than
# true/1/yes/on leaves the feature out.
# ENABLE_CLOUDFLARE_DEPLOYMENT=true

# Optional relay fallbacks for CI or headless bootstrap. The hub panel is the
# normal place to set these; the panel stores tokens encrypted.
# Each variable wins over the matching panel value when it is set.
# The room is always generated and cannot be typed; keep it stable across
# restarts and `pair` commands because pairing codes are scoped to it.
# CLARA_RELAY_URL=wss://relay.example
# CLARA_RELAY_ROOM=
# CLARA_AGENT_TOKEN=

# The hub panel's Web URL is the normal place to set the pairing link.
# Set CLARA_PAIRING_BASE_URL only to override it for automation.
# CLARA_PAIRING_BASE_URL=https://your-clara.example
# Adapter registry for the panel's SSH/Docker installs and manual commands.
# CLARA_ADAPTER_REGISTRY_URL=https://clara.kalenmichael.com/adapters

# Optional VAPID overrides. If unset, vapid.json is generated in the config
# directory and the panel's VAPID contact (or https://clara.local) is used.
# CLARA_VAPID_PUBLIC_KEY=
# CLARA_VAPID_PRIVATE_KEY=
# CLARA_VAPID_SUBJECT=

# Set to 1 when the panel is served through an HTTPS reverse proxy.
# CLARA_PANEL_SECURE_COOKIE=0

# --- Web client container (infra/docker/web.compose.yml) ------------------------

# Host loopback port for the static app. Defaults to 8080. The hub also
# uses it for the default panel Web URL.
# CLARA_WEB_PORT=8080

# Baked into the bundle at image build time. Leave unset to use the relay URL
# carried by each pairing code; local codes keep their own ws:// URL. Set it
# only when the browser must use a different relay endpoint than the agent,
# then rebuild with `--build`. Keep the value here so `pnpm clara rebuild`
# recreates the image with the same endpoint.
# VITE_CLARA_WS_URL=wss://relay.example


# --- OpenCode adapter (infra/docker/adapter-opencode.compose.yml) ----------------
# The adapter connects out to the hub; it publishes no ports. Pair it once:
#   docker compose -f infra/docker/adapter-opencode.compose.yml run --rm adapter \
#     install --pair <code> --opencode-url http://opencode:4096
# CLARA_OPENCODE_URL=http://opencode:4096
# CLARA_OPENCODE_PASSWORD=
# Optional: override the hub WebSocket. Defaults to ws://server:8788/ws.
# CLARA_ADAPTER_WS_URL=ws://server:8788/ws
# Optional bind mounts for the adapter config and identity.
# CLARA_ADAPTER_CONFIG_DIR=/absolute/path/to/adapter-config
# CLARA_ADAPTER_DATA_DIR=/absolute/path/to/adapter-data
