{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clara-relay",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": true,
  // Preview/version URLs are opt-in: they add public hostnames outside host-scoped WAF rules.
  "preview_urls": false,
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "RELAY_ROOMS",
        "class_name": "RelayRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RelayRoom"],
    },
  ],
  // Deploy to the workers.dev URL by default. To use your own relay host, add
  // a custom domain route for your zone:
  // "routes": [{ "pattern": "relay.example.com", "custom_domain": true }],
}
