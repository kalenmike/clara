{
  "name": "@clara/api-mcp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Read-only hub API MCP tools and stdio bridge.",
  "bin": {
    "clara-api-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx src/bin.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clara/api-client": "workspace:*",
    "@clara/runtime-state": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
