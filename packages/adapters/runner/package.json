{
  "name": "@clara/runner",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shared script runner for Clara harness adapters.",
  "bin": {
    "clara-runner": "./dist/cli.js",
    "clara-runner-install": "./dist/install-cli.js"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "clean": "node ../../../tools/build/clean.mjs dist",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
