{
  "name": "clara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "export CLARA_MANAGEMENT=${CLARA_MANAGEMENT:-1} VITE_CLARA_MANAGEMENT=${VITE_CLARA_MANAGEMENT:-1}; pnpm --parallel --filter @clara/web --filter @clara/server dev",
    "dev:web": "pnpm --filter @clara/web dev",
    "dev:panel": "pnpm --filter @clara/panel dev",
    "dev:server": "pnpm --filter @clara/server dev",
    "dev:relay": "pnpm --filter @clara/relay dev",
    "build": "export CLARA_MANAGEMENT=${CLARA_MANAGEMENT:-1} VITE_CLARA_MANAGEMENT=${VITE_CLARA_MANAGEMENT:-1}; pnpm -r --if-present build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm test:scripts && pnpm -r --if-present test",
    "test:scripts": "node --test scripts/test/*.test.mjs",
    "knip": "knip",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm test",
    "commitlint": "commitlint --last",
    "prepare": "husky",
    "deploy:web": "pnpm --filter @clara/web run deploy",
    "deploy:relay": "pnpm --filter @clara/relay run deploy",
    "clara:serve": "export CLARA_MANAGEMENT=${CLARA_MANAGEMENT:-1}; pnpm --filter @clara/server exec node dist/index.js",
    "clara": "node scripts/clara.mjs",
    "task": "node scripts/task.mjs",
    "clara:control": "export CLARA_MANAGEMENT=${CLARA_MANAGEMENT:-1}; node scripts/control.mjs",
    "clara:plugin:install": "node scripts/install-clara-plugin.mjs",
    "clara:plugin:uninstall": "node scripts/uninstall-clara-plugin.mjs",
    "clara:ledger": "pnpm --filter @clara/opencode-plugin cli",
    "clara:pair": "pnpm --filter @clara/server exec node dist/index.js pair",
    "clara:pair:local": "pnpm --filter @clara/server exec node dist/index.js pair --local",
    "clara:pass": "jq -r '.password' $HOME/.local/state/opencode/service.json"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.44.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12"
  }
}
