{
  "name": "clara",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @clara/web --filter @clara/hub-server dev",
    "dev:web": "pnpm --filter @clara/web dev",
    "dev:panel": "pnpm --filter @clara/hub-panel dev",
    "dev:lab": "pnpm --filter @clara/lab dev",
    "dev:server": "pnpm --filter @clara/hub-server dev",
    "dev:relay": "pnpm --filter @clara/relay dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present test",
    "knip": "knip",
    "check:boundaries": "node tools/cli/src/commands/check-boundaries.mjs",
    "check": "pnpm typecheck && pnpm check:boundaries && pnpm lint && pnpm format:check && pnpm knip && pnpm docs:check && pnpm test",
    "commitlint": "commitlint --last",
    "prepare": "husky",
    "deploy:web": "pnpm --filter @clara/web run deploy",
    "deploy:relay": "pnpm --filter @clara/relay run deploy",
    "desktop:dev": "pnpm --filter @clara/desktop dev",
    "desktop:build": "pnpm --filter @clara/desktop bundle",
    "desktop:build:app": "pnpm --filter @clara/desktop bundle:app",
    "desktop:build:docker": "pnpm --filter @clara/desktop build:docker",
    "desktop:icons": "pnpm --filter @clara/desktop icons",
    "hub:dev": "pnpm --filter @clara/hub-desktop dev",
    "hub:build": "pnpm --filter @clara/hub-desktop bundle",
    "hub:build:app": "pnpm --filter @clara/hub-desktop bundle:app",
    "hub:build:docker": "pnpm --filter @clara/hub-desktop build:docker",
    "hub:headless": "pnpm --filter @clara/hub-desktop headless",
    "hub:sidecar": "pnpm --filter @clara/hub-desktop sidecar",
    "hub:icons": "pnpm --filter @clara/hub-desktop icons",
    "clara": "node tools/cli/src/main.mjs",
    "task": "node tools/cli/src/task.mjs",
    "docs": "node tools/cli/src/main.mjs docs",
    "docs:build": "pnpm --filter @clara/docs build",
    "docs:preview": "pnpm --filter @clara/docs preview",
    "docs:check": "node tools/cli/src/commands/docs-check.mjs",
    "docs:typecheck": "pnpm --filter @clara/docs typecheck"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "knip": "^6.44.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  },
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22.12"
  }
}
