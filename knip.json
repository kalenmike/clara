{
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/test/*.test.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/web": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/panel": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/server": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/shared-types": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/crypto": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "plugins/clara": {
      "project": ["*.ts"]
    },
    "workers/relay": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/policy": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/orchestration": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/mcp-server": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/orchestrator": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/mcp": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    }
  },
  "ignore": [
    "apps/web/src/components/ui/**",
    "apps/web/src/features/clara/stub/**",
    "apps/panel/src/features/clara/stub/**"
  ],
  "ignoreDependencies": ["cloudflare"],
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
