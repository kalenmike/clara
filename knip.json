{
  "workspaces": {
    "apps/web": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/server": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/shared-types": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/crypto": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "workers/relay": {
      "project": ["src/**/*.ts", "test/**/*.ts"],
      "ignoreDependencies": ["cloudflare"]
    }
  },
  "ignore": ["apps/web/src/components/ui/**"],
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
