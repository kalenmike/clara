{
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "scripts/test/*.test.mjs"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/web": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "apps/panel": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx,css}"]
    },
    "apps/lab": {
      "entry": ["index.html"],
      "project": ["src/**/*.{ts,tsx}", "server/**/*.ts", "test/**/*.ts"]
    },
    "apps/server": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/shared-types": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/crypto": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "workers/relay": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/policy": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/orchestration": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/orchestration-control": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/devtools": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/mcp-server": {
      "project": ["src/**/*.ts"]
    },
    "apps/orchestrator": {
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/mcp": {
      "project": ["src/**/*.ts"]
    },
    "plugins/clara-policy": {
      "project": ["*.ts"]
    }
  },
  "ignore": ["apps/web/src/components/ui/**"],
  "ignoreBinaries": ["ss"],
  "ignoreDependencies": ["yaml", "cloudflare", "better-sqlite3"],
  "rules": {
    "exports": "off",
    "types": "off"
  }
}
