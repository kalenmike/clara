{
  "name": "@clara/adapter-opencode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Clara OpenCode harness adapter",
  "bin": {
    "clara-adapter-opencode": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts serve",
    "start": "node dist/index.js",
    "build": "tsup && node scripts/copy-plugin-assets.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clara/adapter-runtime": "workspace:*",
    "@clara/api-contract": "workspace:*",
    "@clara/binding-core": "workspace:*",
    "@clara/mcp": "workspace:*",
    "@clara/runner": "workspace:*",
    "@clara/shared-types": "workspace:*",
    "@opencode/client": "2.1.1",
    "hono": "^4.13.17",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "exports": {
    "./install": "./src/install.ts",
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  }
}
