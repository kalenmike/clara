{
  "name": "@clara/adapter-claude",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Clara Claude Code harness adapter",
  "bin": {
    "clara-adapter-claude": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts serve",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.325",
    "@clara/adapter-runtime": "workspace:*",
    "@clara/api-contract": "workspace:*",
    "@clara/shared-types": "workspace:*",
    "hono": "^4.13.17",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  }
}
