{
  "name": "@clara/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "clara-server": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "pnpm --filter @clara/panel build",
    "build": "tsup && node scripts/copy-panel.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pair": "tsx src/index.ts pair",
    "pair:no-relay": "tsx src/index.ts pair --no-relay"
  },
  "dependencies": {
    "@clara/crypto": "workspace:*",
    "@clara/orchestration-control": "workspace:*",
    "@clara/shared-types": "workspace:*",
    "@opencode/client": "2.1.1",
    "better-sqlite3": "^13.0.3",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
