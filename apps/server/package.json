{
  "name": "@clara/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "clara-server": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "pair": "tsx src/index.ts pair"
  },
  "dependencies": {
    "@clara/crypto": "workspace:*",
    "@clara/shared-types": "workspace:*",
    "qrcode-terminal": "^0.12.0",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
