# OpenCode connection. service.json is used when these are unset.
CLARA_OPENCODE_URL=http://127.0.0.1:4096
# CLARA_OPENCODE_PASSWORD=

# Local WebSocket listener for devices on this machine.
CLARA_LOCAL_HOST=127.0.0.1
CLARA_LOCAL_PORT=8788

# Read-only agent panel. It always listens on loopback, independent of
# CLARA_LOCAL_HOST. Set CLARA_PANEL_DISABLED=1 to turn it off.
# CLARA_PANEL_PORT=8790
# CLARA_PANEL_DISABLED=1
# CLARA_PANEL_DIR=/path/to/built/panel

# Cloudflare relay. Leave CLARA_RELAY_URL unset for local-only mode.
# CLARA_RELAY_URL=wss://relay.clara.kalenmichael.com

# Optional; auto-generated and stored in server.json
# CLARA_RELAY_ROOM=

# Secrets pushed with worker
# CLARA_AGENT_TOKEN=
# CLARA_CLIENT_TOKEN=

# Optional override. Otherwise generated at ~/.config/clara/server.json.
# CLARA_PSK=

CLARA_PAIRING_BASE_URL=https://clara.kalenmichael.com
