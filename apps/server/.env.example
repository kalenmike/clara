# Clara home agent environment reference. The agent does not load this file:
# export these variables, put them in ~/.config/clara/server.env for the
# systemd unit, or set them in the compose environment.

# Config and data directories. Defaults follow XDG.
# CLARA_CONFIG_DIR=/home/you/.config/clara
# CLARA_DATA_DIR=/home/you/.local/share/clara

# Agent settings database. Defaults to <CLARA_DATA_DIR>/clara.db.
# CLARA_DB_PATH=/home/you/.local/share/clara/clara.db

# Local WebSocket listener for devices on this machine. CLARA_LOCAL_BIND_HOST
# changes the bind address without changing the URL carried by pairing codes.
CLARA_LOCAL_HOST=127.0.0.1
CLARA_LOCAL_PORT=8788
# CLARA_LOCAL_BIND_HOST=0.0.0.0

# Agent panel and controls. It listens on loopback by default. Set
# CLARA_PANEL_DISABLED=1 to turn it off, or the bind/allow-remote pair to
# publish it from a container. CLARA_PANEL_SECURE_COOKIE=1 marks the session
# cookie Secure behind an HTTPS reverse proxy.
# CLARA_PANEL_PORT=8790
# CLARA_PANEL_DISABLED=1
# CLARA_PANEL_BIND_HOST=127.0.0.1
# CLARA_PANEL_ALLOW_REMOTE=0
# CLARA_PANEL_SECURE_COOKIE=0

# First-run panel setup token. Prefer a file outside the config directory.
# CLARA_ADMIN_SETUP_TOKEN=
# CLARA_ADMIN_SETUP_TOKEN_FILE=/run/secrets/clara-admin-setup

# Key that encrypts harness credentials at rest. Otherwise the agent generates
# secrets.key in the config directory.
# CLARA_SECRET_KEY=
# CLARA_SECRET_KEY_FILE=/run/secrets/clara-secret-key

# Cloudflare relay. Leave CLARA_RELAY_URL unset for local-only mode.
# CLARA_RELAY_URL=wss://relay.example

# Optional; auto-generated and stored in server.json
# CLARA_RELAY_ROOM=

# Secrets pushed with worker
# CLARA_AGENT_TOKEN=
# CLARA_CLIENT_TOKEN=

# Optional override. Otherwise generated at ~/.config/clara/server.json.
# CLARA_PSK=

# URL where the Clara web app is served. Set it in the agent panel; this
# environment value overrides the panel for automation.
# CLARA_PAIRING_BASE_URL=https://your-clara.example

# Host port of the Clara web client, used for the default panel Web URL.
# CLARA_WEB_PORT=8080

# Optional VAPID overrides. The panel's VAPID contact or https://clara.local is
# used otherwise.
# CLARA_VAPID_PUBLIC_KEY=
# CLARA_VAPID_PRIVATE_KEY=
# CLARA_VAPID_SUBJECT=
