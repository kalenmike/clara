{
  "name": "@clara/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tauri shell that packages the Clara web client for desktop.",
  "scripts": {
    "clean": "node ../../tools/build/clean.mjs src-tauri/target/release/bundle",
    "dev": "pnpm --filter @clara/desktop-host run bundle && tauri dev",
    "bundle": "pnpm --filter @clara/desktop-host run bundle && tauri build",
    "bundle:app": "pnpm --filter @clara/desktop-host run bundle && tauri build --no-bundle",
    "build:docker": "node scripts/build-docker.mjs",
    "install:app": "node scripts/install.mjs",
    "uninstall:app": "node scripts/install.mjs --uninstall",
    "host": "pnpm --filter @clara/desktop-host run build",
    "icons": "tauri icon ../web/public/clara-mark.png"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4"
  }
}
