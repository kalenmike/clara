{
  "name": "@clara/hub-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    "./main": "./src/main.ts"
  },
  "bin": {
    "clara-server": "./dist/index.js"
  },
  "scripts": {
    "clean": "node ../../../tools/build/clean.mjs dist",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "prebuild": "pnpm --filter @clara/hub-panel build",
    "build": "tsup && node scripts/build-relay.mjs && node scripts/check-bundle.mjs && node scripts/check-feature-bundle.mjs && node scripts/copy-panel.mjs",
    "build:bun": "node scripts/build-bun.mjs",
    "headless": "node scripts/build-headless.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "smoke:bun": "bun scripts/bun-smoke.ts",
    "pair": "tsx src/index.ts pair",
    "pair:no-relay": "tsx src/index.ts pair --no-relay"
  },
  "dependencies": {
    "@clara/adapter-install": "workspace:*",
    "@clara/api-contract": "workspace:*",
    "@clara/crypto": "workspace:*",
    "@clara/runtime-state": "workspace:*",
    "@clara/service-control": "workspace:*",
    "@clara/shared-types": "workspace:*",
    "@clara/sqlite": "workspace:*",
    "@hono/node-server": "^2.1.6",
    "@hono/swagger-ui": "^0.6.2",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.17",
    "hono-openapi": "^1.5.0",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "ws": "^8.22.1",
    "zod": "^4.6.7",
    "@clara/harness-protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.19.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2",
    "openapi-types": "^12.1.3",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
