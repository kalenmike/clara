{
  "name": "@clara/hub-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Tauri tray app that runs the Clara hub and opens the panel.",
  "scripts": {
    "dev": "node scripts/build-sidecar.mjs && tauri dev",
    "bundle": "node scripts/build-sidecar.mjs && tauri build",
    "bundle:app": "node scripts/build-sidecar.mjs && tauri build --no-bundle",
    "build:docker": "node scripts/build-docker.mjs",
    "headless": "node scripts/build-headless.mjs",
    "sidecar": "node scripts/build-sidecar.mjs",
    "icons": "tauri icon ../../web/public/clara-mark.png",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@clara/hub-server": "workspace:*"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.19.2",
    "typescript": "~6.0.3"
  }
}
