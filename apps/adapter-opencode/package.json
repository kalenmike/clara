{
  "name": "@clara/adapter-opencode",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Clara OpenCode harness adapter",
  "bin": {
    "clara-adapter-opencode": "./dist/index.js"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts serve",
    "start": "node dist/index.js",
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clara/api-contract": "workspace:*",
    "@clara/crypto": "workspace:*",
    "@clara/harness-protocol": "workspace:*",
    "@clara/shared-types": "workspace:*",
    "hono": "^4.13.17",
    "ws": "^8.22.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "exports": {
    "./install": "./src/install.ts",
    ".": "./src/index.ts",
    "./config": "./src/config.ts",
    "./service": "./src/service.ts",
    "./state": "./src/state.ts",
    "./package.json": "./package.json"
  }
}
