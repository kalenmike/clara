{
  "name": "@clara/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/check-bundle.mjs --dir dist --surface web",
    "build:desktop": "tsc -b && vite build --mode desktop && node scripts/check-bundle.mjs --dir dist-desktop --surface desktop",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name clara"
  },
  "dependencies": {
    "@clara/api-client": "workspace:*",
    "@clara/api-contract": "workspace:*",
    "@clara/crypto": "workspace:*",
    "@clara/lab": "workspace:*",
    "@clara/panel": "workspace:*",
    "@clara/shared-types": "workspace:*",
    "@fontsource-variable/geist": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-virtual": "^3.14.24",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.64.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router": "^8.5.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
