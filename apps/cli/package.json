{
  "name": "@clara/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Packaged Clara command for the hub, engine, lab, and web client.",
  "bin": {
    "clara": "./src/main.ts"
  },
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "clean": "node ../../tools/build/clean.mjs dist src/embedded-assets.generated.mjs",
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "build:binary": "node scripts/build-binary.mjs",
    "build:binary:cached": "node scripts/build-binary.mjs --skip-assets",
    "check:bundle": "node scripts/check-bundle.mjs",
    "install:local": "node scripts/install.mjs",
    "smoke": "node scripts/smoke.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "uninstall:local": "node scripts/install.mjs --uninstall"
  },
  "dependencies": {
    "@clara/adapter-artifact": "workspace:*",
    "@clara/adapter-state": "workspace:*",
    "@clara/engine": "workspace:*",
    "@clara/hub-server": "workspace:*",
    "@clara/lab-server": "workspace:*",
    "@clara/release": "workspace:*",
    "@clara/runner": "workspace:*",
    "@clara/runtime-state": "workspace:*",
    "@clara/service-control": "workspace:*",
    "@clara/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
