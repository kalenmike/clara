{
  "name": "@clara/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Packaged Clara command for the hub, engine, and web client.",
  "bin": {
    "clara": "./src/main.ts"
  },
  "exports": {
    ".": "./src/main.ts"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "start": "tsx src/main.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@clara/engine": "workspace:*",
    "@clara/hub-server": "workspace:*",
    "@clara/runner": "workspace:*",
    "@clara/runtime-state": "workspace:*",
    "@clara/shared-types": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
