[Unit]
Description=Clara Home Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/jet/Projects/clara
Environment=PATH=/home/jet/.nvm/versions/node/v22.22.0/bin:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-%h/.config/clara/server.env
ExecStart=/home/jet/.nvm/versions/node/v22.22.0/bin/node /home/jet/Projects/clara/apps/server/dist/index.js
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
