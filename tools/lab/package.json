{
  "name": "@clara/lab-cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "clara-lab": "./dist/server/index.js"
  },
  "scripts": {
    "clean": "node ../../tools/build/clean.mjs dist",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "build": "vite build && tsup",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@clara/lab": "workspace:*",
    "@clara/lab-server": "workspace:*",
    "@clara/pipeline-preview": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.24.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
